{
  // Output detail: final, concise, detail, or full.
  "output": "concise",
  // Automatically continue replayable incomplete assistant responses.
  "auto_resume": false,
  // Providers and models, in default and fallback order.
  "providers": {
    // Default provider: OpenCode Zen's free DeepSeek and Mimo models. They need
    // no API key, so mu works out of the box.
    "opencode": {
      // Complete HTTP(S) URL or http+unix API request endpoint.
      "endpoint": "https://opencode.ai/zen/v1/chat/completions",
      // Environment variable containing the API key; omit for keyless access.
      // "api_key_env": "OPENCODE_API_KEY",
      // Available models, in default order.
      "models": {
        "deepseek-v4-flash-free": {
          // Efforts shown by status and completion.
          // "supported_efforts": ["low", "medium", "high"],
          // Native replay compatibility group.
          // "replay_key": "compatible-family",
          // Token limit used for status and compaction.
          "context_window": 200000
        },
        "mimo-v2.5-free": {
          // Token limit used for status and compaction.
          "context_window": 200000
        }
      }
    }
    // Example keyed provider. Add OPENAI_API_KEY to ~/.mu/.env, then select it
    // with `mu --model openai/gpt-4o`.
    // "openai": {
    //   "endpoint": "https://api.openai.com/v1/chat/completions",
    //   "api_key_env": "OPENAI_API_KEY",
    //   "models": {
    //     "gpt-4o": {
    //       "context_window": 128000
    //     }
    //   }
    // }
  },
  // Bell after a long successful terminal turn.
  "terminal_bell": {
    // Enable the completion bell.
    "enabled": true,
    // Minimum turn duration before ringing.
    "min_duration_ms": 10000
  },
  // Automatic context compaction thresholds.
  "compaction": {
    // Enable automatic compaction.
    "enabled": true,
    // Compact before materializing a queued new prompt at this fraction.
    "soft_fraction": 0.70,
    // Compact before returning completed Bash results at this fraction.
    "hard_fraction": 0.85,
    // Hard-threshold reserve, emergency reduction, and summary output cap.
    "hard_headroom_tokens": 48000
  },
  // Agent-loop and Bash-output limits.
  "limits": {
    // Maximum agent iterations per turn.
    "max_iterations": 50,
    // Maximum retained Bash-output lines.
    "max_lines": 2000,
    // Maximum retained Bash-output bytes.
    "max_bytes": 51200,
    // Maximum retained bytes per Bash-output line.
    "max_line_bytes": 10240
  },
  // Environment values redacted from Bash output.
  "redaction": {
    // Exact names or *suffix selectors to redact.
    "env": ["*_API_KEY", "*_API_TOKEN", "*_AUTH_TOKEN"]
  },
  // Review destructive Bash calls.
  "guardrail": {
    // Enable destructive-call review.
    "enabled": true,
    // Fixed reviewer; omit to use the active model.
    // "review_model": "opencode/deepseek-v4-flash-free",
    // Reviewer timeout in seconds.
    "timeout_seconds": 120,
    // Maximum denied attempts in one turn.
    "max_denials_per_turn": 3
  }
}
